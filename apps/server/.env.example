# Talkr Platform server env. Copy to .env.local (gitignored) and fill in.
# The server refuses to boot half-configured (zod-validated in src/config.ts).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres (Supabase project connection string in prod; local PG in dev/tests)
DATABASE_URL=postgres://postgres@127.0.0.1:5544/talkr_platform

# The EXACT public origin the carrier posts webhooks to (tunnel URL in local dev).
PUBLIC_BASE_URL=https://your-tunnel.example.com

# HS256 secret used to verify user JWTs (Supabase project JWT secret).
AUTH_JWT_SECRET=

# Browser origin(s) allowed to call the /v1 API (the web app URL; comma-separated for more than one)
WEB_ORIGIN=http://localhost:3100

# Supabase Auth, for email + password sign-in from the web app and the Chrome
# extension (POST /v1/auth/login). The API proxies GoTrue so the anon key never
# ships in a bundle. Leave both blank and clients fall back to pasting a JWT —
# AUTH_JWT_SECRET (the same project's JWT secret) verifies either.
# SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# Service-role key — server-only, never in a browser. Used solely to send the
# invite email when an admin adds a teammate on the Team page. Leave blank and
# teammates are still added; they just get no email until it is set.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client id for "Continue with Google" (POST /v1/auth/google). The
# one ending .apps.googleusercontent.com — NOT the client secret beside it in
# Google's console (those start GOCSPX-). This value is public: /v1/auth/config
# serves it to every client, so a secret pasted here would be published. The
# secret's only home is the Supabase dashboard's Google provider. Clients read this back from /v1/auth/config and talk to Google
# themselves, so leaving it blank simply means no Google button is offered.
# Setup, including the extension's fixed redirect URI: docs/deploy.md.
# Create your OWN OAuth client in Google Cloud; this repo ships no Google
# credentials. Example of the shape (a dummy, will not work):
#   GOOGLE_OAUTH_CLIENT_ID=000000000000-dummyclientid.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=

# Product testing without sign-in. Set to the email of an active user and every
# /v1 request with no valid bearer runs as them; the web app then skips its
# sign-in screen. Anyone who can reach the server acts as this user, so only on
# a server whose data you would share. Unset it to restore sign-in.
AUTH_BYPASS_USER_EMAIL=

# Which carrier to use: telnyx | none (docs/architecture.md §4). `none` boots
# with no carrier (no calls or texts, everything else works) for product testing
# before a carrier account exists.
VOICE_PROVIDER=telnyx

# ── Telnyx (required when VOICE_PROVIDER=telnyx) ──────────────────────────────
# portal.telnyx.com. NOTE: the API key and the webhook public key are two
# different credentials from two different pages — mixing them up is the
# usual first-run failure.
TELNYX_API_KEY=
# Base64 Ed25519 *public* key, used only to verify inbound webhooks.
TELNYX_PUBLIC_KEY=
TELNYX_ACCOUNT_ID=
# TeXML Application whose Voice URL is {PUBLIC_BASE_URL}/twiml/outbound-dial.
# The /webhooks/twilio paths are historical names from before the move to
# Telnyx; they are registered on the Telnyx app and profile, so they stay.
TELNYX_TEXML_APP_ID=
# SIP Connection that browser (WebRTC) credentials are minted against.
TELNYX_SIP_CONNECTION_ID=
TELNYX_MESSAGING_PROFILE_ID=
# SIP domain reps' browsers are reachable at. Telnyx generates each rep's SIP
# username when their credential is created; the mapping lives in the
# telephony_credentials table, not here.
TELNYX_SIP_DOMAIN=sip.telnyx.com

# Podio app auth (optional until the CRM integration is wired)
PODIO_CLIENT_ID=
PODIO_CLIENT_SECRET=
PODIO_APP_ID=
PODIO_APP_TOKEN=

# Where mirrored recording media lands (object storage later)
RECORDINGS_DIR=./data/recordings

# ── Transcription + AI call notes (docs/transcription.md) ─────────────────────
# Deepgram key (console.deepgram.com). Blank: recordings still play, transcripts read "not configured".
DEEPGRAM_API_KEY=
# Anthropic key (console.anthropic.com). Blank: transcripts complete without the AI notes.
ANTHROPIC_API_KEY=
# Messages-API model that writes the notes; Sonnet 5 is the low-cost default.
AI_SUMMARY_MODEL=claude-sonnet-5

# Run worker inside the API process (dev only; prod runs worker-main.ts)
WORKER_INLINE=true

# Serverless only: the bearer the host's cron sends to GET /internal/tick.
# At least 16 characters (openssl rand -hex 32). Unset, the tick refuses everyone.
# CRON_SECRET=

# Post-terminal reconciliation delay
# How a browser outbound call is wired (docs/telephony-events.md §9).
# conference = hold / add call / merge / transfer work. bridge = Phase 2 two-leg dial.
CALL_CONTROL_MODE=conference

RECONCILE_DELAY_MS=120000

# ── Sequences (docs/sequences.md) ─────────────────────────────────────────────
# Model behind "Draft with AI" on /sequences. Blank: same as AI_SUMMARY_MODEL.
# Shares ANTHROPIC_API_KEY; without it the button explains what is missing.
AI_BUILDER_MODEL=
