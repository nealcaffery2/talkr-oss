{
  "name": "@talkr/voice-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Talkr Voice: Chrome MV3 softphone — popup dialer and side-panel call console.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "dev:content": "vite build --watch --mode development --config vite.content.config.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && rm -f talkr-voice.zip && cd dist && zip -qr ../talkr-voice.zip .",
    "package:store": "npm run build && node scripts/store-zip.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@telnyx/webrtc": "2.27.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
