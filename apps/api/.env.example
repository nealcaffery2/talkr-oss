# Talkr backend env. Copy to .env.local and fill in.
# .env.local is gitignored. Vercel deploys read from project env vars (set those separately).

# ---- Supabase ----
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Service role key (NEVER ship to extension or browser, server-side only)
SUPABASE_SERVICE_ROLE_KEY=
# Anon key (safe for browser use via PostgREST/RLS)
SUPABASE_ANON_KEY=

# ---- Anthropic ----
# console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# ---- Deepgram ----
# console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=

# ---- Voyage AI (embeddings) ----
# voyageai.com -> Dashboard -> API Keys
VOYAGE_API_KEY=

# ---- smrtPhone ----
# smrtPhone settings -> API
SMRTPHONE_API_KEY=
SMRTPHONE_WEBHOOK_SIGNING_SECRET=

# ---- Podio ----
# podio.com/settings/api for OAuth client creds
PODIO_CLIENT_ID=
PODIO_CLIENT_SECRET=
# Talkr joins: smrtPhone call -> Communications app (call/SMS log) -> Acquisitions app (deal + disposition)
# Per-app auth tokens (recommended): app -> Developer -> Generate authentication token
PODIO_COMMUNICATIONS_APP_ID=
PODIO_COMMUNICATIONS_APP_TOKEN=
PODIO_ACQUISITIONS_APP_ID=
PODIO_ACQUISITIONS_APP_TOKEN=
# Fallback: OAuth password flow
PODIO_USERNAME=
PODIO_PASSWORD=

# ---- Misc ----
MAX_LIVE_SESSION_MINUTES=120
NODE_ENV=development

# Shared Bearer secret used by the Chrome extension to call the API.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TALKR_API_KEY=
# Deepgram project id (use "self" for personal accounts).
DEEPGRAM_PROJECT_ID=self
